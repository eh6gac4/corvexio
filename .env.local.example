# Copy this file to .env.local for local development against a real vault, or to .env
# (gitignored) for a local `docker compose up`, and fill in real values. The N100
# deployment doesn't use this file — Portainer sets these as stack environment
# variables instead (see README.md).

# Base URL of the Obsidian Local REST API. Use the HTTPS port (27124), not the HTTP port (27123).
OBSIDIAN_API_URL=https://192.168.1.253:27124

# Bearer token from Obsidian -> Settings -> Local REST API (with MCP) -> API Key.
OBSIDIAN_API_KEY=replace-with-your-api-key

# The Local REST API plugin serves a self-signed HTTPS certificate by default.
# "true" disables TLS verification for calls to OBSIDIAN_API_URL only (not process-wide).
# This is acceptable when the API is only reachable over a trusted WireGuard/LAN link.
OBSIDIAN_TLS_INSECURE=true
